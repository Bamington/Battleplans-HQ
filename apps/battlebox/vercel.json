{
  "rewrites": [
    {
      "source": "/:handle(@[^/]+)",
      "destination": "/api/profile-og?handle=:handle"
    },
    {
      "source": "/s/:handle/:token",
      "destination": "/api/share-og?token=:token"
    },
    {
      "source": "/s/:token",
      "destination": "/api/share-og?token=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
