# Generated by the scripts in this folder — all of it is re-derivable, goes
# stale the moment a battle changes, and battles.json is a dump of live rows
# (opponent names and all) that has no business in git.
inventory.json
battles.json
metadata.json
match-manifest.json
*.raw.json

# The photos themselves never live in the repo — download.mjs puts them under
# %LOCALAPPDATA%\notion-battle-photos by default.
photos/

# sharp is installed here ad hoc for the one-off resize in upload.mjs
node_modules/
package-lock.json
